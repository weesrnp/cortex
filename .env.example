# Copie para .env e ajuste. O .env nunca vai para o Git, e tudo nele também chega ao Cortex (env_file do compose).

# Banco (Postgres + pgvector). Porta 5433 no host para não brigar com um Postgres local na 5432.
# A senha vale na CRIAÇÃO do volume: trocar depois exige ALTER USER no banco (ou apagar o volume e reindexar).
POSTGRES_DB=cortex
POSTGRES_USER=cortex
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5433

# Embeddings locais (Ollama). Nada sai da máquina.
EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_PORT=11434
# Já tem um Ollama no host? Aponte para ele e troque OLLAMA_PORT (a porta 11434 já está em uso pelo seu Ollama).
# No Linux, o Ollama do host precisa escutar fora do 127.0.0.1 (OLLAMA_HOST=0.0.0.0).
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_PORT=11435

# Cofre do Obsidian no host (barras normais / também no Windows)
VAULT_HOST_PATH=./exemplo-vault
# Linux: uid e gid do dono do cofre (rode `id -u` e `id -g`), para o Cortex poder gravar notas nele
CORTEX_UID=1000
CORTEX_GID=1000

# Perfil da área (pasta em perfis/): siglas, instruções do MCP, metadados, limiares e perguntas de avaliação.
# Vazio (PERFIL=) = núcleo neutro, sem perfil.
PERFIL=exemplo

# API REST + MCP (http://127.0.0.1:8900/mcp)
API_PORT=8900
# Mais de uma instância na mesma máquina: nome de projeto e portas diferentes em cada cópia
# COMPOSE_PROJECT_NAME=cortex-trabalho

# Índice
INDEX_PDF=true
PDF_EXCLUDE_PATTERN=(?i)confidencial|sigiloso|nominal
EXPAND_SIGLAS=true
